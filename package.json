{
  "name": "davidia",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiamondLightSource/davidia.git"
  },
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm --filter {client/example} start",
    "build": "pnpm --filter {client/*} build",
    "start:storybook": "pnpm --filter storybook start",
    "build:storybook": "pnpm --filter storybook build && pnpx cpy-cli typedocs/index.html storybook/storybook-static/",
    "test": "pnpm --filter {client/component} test",
    "prettify": "prettier -w client storybook",
    "lint": "pnpm --filter {client/*} --filter storybook lint",
    "lint-fix": "pnpm --filter {client/*} --filter storybook lint-fix",
    "lint:tsc": "pnpm tsc --noEmit",
    "docs": "pnpm --filter {client/component} run docs",
    "bump-vpatch": "pnpm --filter {client/*} --filter storybook exec pnpm version patch"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@diamondlightsource/davidia": "link:client/component"
  }
}
