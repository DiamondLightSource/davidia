{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "typeRoots": [ "client/types" ],
    "baseUrl": ".",
    "paths": {
      "ndarray-concat-rows": ["./client/types/ndarray-concat-rows"],
        "@diamondlightsource/davidia": [
          "client/component/src/index.ts"
        ],
        "@diamondlightsource/davidia/index.css": [
          "client/component/src/index.css"
        ]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["client", "storybook"],
  "exclude": ["node_modules", "client/types"]
}
